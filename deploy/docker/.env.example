# Copy to .env and adjust the host paths before starting.
ECHO_SERVICE_IMAGE=echo-service:amd64
ECHO_SERVICE_PORT=9090
ECHO_DATA_DIR=./data
ECHO_DB_PATH=/app/data/echo-service.db
ECHO_HTTP_LISTEN=0.0.0.0:9090
# Build-only credential file for private Go modules. Keep outside this package.
ECHO_NETRC_FILE=/dev/null
