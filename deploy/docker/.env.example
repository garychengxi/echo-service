# Copy to .env and adjust the host paths before starting.
ECHO_SERVICE_IMAGE=echo-service:amd64
ECHO_SERVICE_PORT=9090
ECHO_DATA_DIR=./data
ECHO_DB_PATH=/app/data/echo-service.db
ECHO_HTTP_LISTEN=0.0.0.0:9090
# Allow concurrent logins by default; true makes a new login revoke older ones.
ECHO_AUTH_SINGLESESSION=false
ECHO_AUTH_ACCESSTOKENTTL=24h
ECHO_AUTH_REFRESHTOKENTTL=168h
ECHO_AGENTCONNECTION_MAXMESSAGEBYTES=52428800
ECHO_EVENTSTREAM_SUBSCRIBERQUEUESIZE=256
# Exact browser origins, comma-separated, when HTTPS terminates at a gateway.
ECHO_EVENTSTREAM_ALLOWEDORIGINS=
